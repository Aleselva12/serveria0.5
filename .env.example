# Cora local development environment template
# Copy this file to .env and fill only the values you need.
# The application is designed to work in local-first mode without cloud credentials.

# Required for the local model runtime
OLLAMA_MODEL=gpt-oss:20b
OLLAMA_BASE_URL=http://localhost:11435

# Optional app settings
APP_ENV=development
LOG_LEVEL=INFO

# Optional cloud integrations (not required for the base local flow)
# Search / web lookup
TAVILY_API_KEY=

# Future / optional AI integrations
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional Gmail / Google Calendar credentials
# Keep these as paths to local OAuth credential files if you enable those integrations.
GOOGLE_CLIENT_SECRET_PATH=
GOOGLE_CALENDAR_CREDENTIALS_PATH=
GMAIL_CREDENTIALS_PATH=

# Optional tracing / telemetry
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Optional local worker / server config
SERVER_HOST=127.0.0.1
SERVER_PORT=8000

# Notes:
# - The base system should start without any of the optional keys above.
# - Missing optional keys must never crash the app or block the local flow.
# - Sensitive tokens must be stored only in .env and never committed to git.
